{
  "manifest_version": 3,
  "name": "DailyQuest",
  "version": "1.0.0",
  "description": "Turn everyday tasks into daily quests. Minimalist productivity tracker.",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "omnibox": {
    "keyword": "dq"
  },
  "permissions": [
    "storage",
    "alarms",
    "contextMenus"
  ],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
